# --- Firebase web config (Project settings → General → Your apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=marfa-spirit-membership.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=marfa-spirit-membership
VITE_FIREBASE_STORAGE_BUCKET=marfa-spirit-membership.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to point Auth/Firestore/Functions at local emulators
VITE_USE_EMULATORS=false

# --- Chain ---
# 8453 = Base, 84532 = Base Sepolia, 1 = Ethereum, 11155111 = Sepolia, 31337 = Anvil
VITE_CHAIN_ID=84532
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Optional: dedicated RPC (falls back to the chain's public RPC)
VITE_RPC_URL=
# Optional: WalletConnect Cloud project id (enables mobile wallets)
VITE_WC_PROJECT_ID=
